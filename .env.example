# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI-compatible endpoint; used here only by the eval's LLM-judge,
#     and by the agent layer that builds on this repo) ---
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=
AI_MODEL=space-bunny-free

# --- Retrieval ---
RETRIEVER=hybrid            # hybrid | mock (mock = 3 fixed items, no models needed)
# Empty = embedded Qdrant on disk (single process). Set for a Qdrant server
# (required when running several API workers), e.g. http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
DEVICE=cpu                  # cuda on a GPU server
RERANKER=minilm             # minilm (default) | none | bge  (see docs/EVALUATION.md)
RERANK_QUERIES=2
RERANK_CANDIDATES=12
# Leave empty to use the tuned default for the chosen RERANKER.
ABSTAIN_THRESHOLD=

# --- Optional hadith search on dorar.net (untested from the cloud; see retrieval/dorar.py) ---
DORAR_ENABLED=0
DORAR_TIMEOUT=8

# --- Paths (defaults are fine) ---
# DATA_DIR=./data
# HF_HOME=~/.cache/huggingface   # where the BGE models are downloaded (~4.5 GB)

# --- Agent / API (agent/, api/) ---
# Optional per-stage models on the same endpoint (default: AI_MODEL for all)
# AI_MODEL_ANALYZE=
# AI_MODEL_ROUTE=
# AI_MODEL_GENERATE=
# AI_MODEL_JUDGE=
# Fallback models tried in order when a model is overloaded (HTTP 429/5xx), comma-separated
# AI_MODEL_FALLBACK=
# Wire protocol: auto (OpenCode Zen: gpt-* -> /responses, claude-* -> /messages, else chat)
# or force chat | responses | anthropic
# AI_PROTOCOL=auto
# Second verification layer: an independent model checks every religious claim against the evidence
# VERIFY_LLM_JUDGE=1
# AI_JUDGE_BASE_URL=https://opencode.ai/zen/v1   # judge endpoint (default: AI_BASE_URL)
# AI_JUDGE_API_KEY=                              # judge key (default: AI_API_KEY)
# AI_MODEL_JUDGE=gpt-5.4-nano
#
# Alternative tested configuration (EVALUATION.md 4.1) — Google AI Studio free tier:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=<AI Studio key from a project WITHOUT billing>
# AI_MODEL=gemini-3.5-flash-lite
# AI_MODEL_ANALYZE=gemini-3.1-flash-lite
# AI_MODEL_ROUTE=gemini-3.1-flash-lite
# AI_MODEL_GENERATE=gemini-3.8-flash
# AI_MODEL_FALLBACK=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_TIMEOUT=60
MAX_DRAFT_ATTEMPTS=2        # 2 = retry once, then return the draft marked "unverified"
PARALLEL_RETRIEVE=1         # search during the router's model call (same results, ~5 s faster)
VERIFY_LLM_JUDGE=0          # 1 = extra LLM faithfulness check in the verifier (+1 call, slower)
CONTEXT_MESSAGES=8
# Access control (service owner). Comma-separated keys for the X-API-Key header.
# Empty = no check: local development only.
MUEEN_API_KEYS=
# Last day the service answers (YYYY-MM-DD). Empty = no end date.
MUEEN_SERVICE_UNTIL=
MUEEN_WARM_UP=1
MUEEN_RUN_LOG=1             # privacy-safe log: ids, levels, cited ids, latency (no message text)
MUEEN_CORS_ORIGINS=         # normally empty: the site's server calls the API, not the browser

# --- Profile: OpenCode Zen paid "balanced" (needs Zen credits on the key's account) ---
# AI_BASE_URL=https://opencode.ai/zen/v1
# AI_API_KEY=<OpenCode Zen key>
# AI_MODEL=claude-haiku-4-5
# AI_MODEL_ANALYZE=gpt-5.4-nano
# AI_MODEL_ROUTE=gpt-5.4-nano
