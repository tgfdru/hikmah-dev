# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenAI-compatible endpoint; used here only by the eval's LLM-judge,
#     and by the agent layer that builds on this repo) ---
AI_BASE_URL=https://opencode.ai/zen/v1
AI_API_KEY=
AI_MODEL=space-bunny-free

# --- Retrieval ---
RETRIEVER=hybrid            # hybrid | mock (mock = 3 fixed items, no models needed)
# Empty = embedded Qdrant on disk (single process). Set for a Qdrant server
# (required when running several API workers), e.g. http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
DEVICE=cpu                  # cuda on a GPU server
RERANKER=none               # none | minilm | bge  (see docs/EVALUATION.md)
RERANK_CANDIDATES=12
# Leave empty to use the tuned default for the chosen RERANKER.
ABSTAIN_THRESHOLD=

# --- Optional hadith search on dorar.net (untested from the cloud; see retrieval/dorar.py) ---
DORAR_ENABLED=0
DORAR_TIMEOUT=8

# --- Paths (defaults are fine) ---
# DATA_DIR=./data
# HF_HOME=~/.cache/huggingface   # where the BGE models are downloaded (~4.5 GB)
